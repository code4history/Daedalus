{
  "name": "@c4h/daedalus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "description": "World-file fitting helpers for Maplat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code4history/Daedalus.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/code4history/Daedalus/issues"
  },
  "homepage": "https://github.com/code4history/Daedalus#readme",
  "engines": {
    "pnpm": ">=10",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/api-smoke.test.ts tests/contract-freeze.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
