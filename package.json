{
  "name": "@c4h/daedalus",
  "version": "0.0.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/types.ts",
    "src/fitting",
    "README.md",
    "README.ja.md"
  ],
  "description": "World-file fitting helpers for Maplat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code4history/Daedalus.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/code4history/Daedalus/issues"
  },
  "homepage": "https://code4history.dev/Daedalus/",
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/api-smoke.test.ts tests/contract-freeze.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "vite --host",
    "build:demo": "vite build",
    "preview": "vite preview",
    "verify:demo": "GITHUB_PAGES=true pnpm run build:demo && node scripts/verify-demo-pages-build.mjs",
    "prepublishOnly": "pnpm run test && pnpm run typecheck && pnpm run test:types && pnpm run build && pnpm run verify:demo"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
